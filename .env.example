# توکن ربات تلگرام (از @BotFather بگیرید)
BOT_TOKEN=your_bot_token_here

# رشته اتصال به دیتابیس PostgreSQL روی Supabase
# مهم: از تب «Connection pooling» استفاده کنید نه «Direct connection» —
# آدرس Direct روی خیلی از هاست‌ها (از جمله Render) فقط IPv6 است و اتصال را با خطای
# "Network is unreachable" رد می‌کند. آدرس پولر (پورت 6543) روی IPv4 هم کار می‌کند.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# برای فازهای بعدی (آپلود فایل در Supabase Storage و Auth پنل وب)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
